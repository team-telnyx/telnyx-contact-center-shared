# Telnyx Contact Center - Environment Variables
# Copy this file to .env and fill in your values

# ===== App / Runtime =====
DEBUG=mcp                          # Debug namespace(s). Use "mcp" for MCP-related logging.
APP_ENV=development                # App environment (development|staging|production).
NODE_ENV=development               # Node environment (development|production).

# ===== Base URLs / CORS =====
ALLOWED_ORIGINS=https://example.com                         # Allowed CORS origins (comma-separated).
ALLOWED_DEV_ORIGINS=https://localhost:3000,https://ngrok.io # Extra dev CORS origins (comma-separated).
NEXT_PUBLIC_BASE_URL=https://example.com                    # Public base URL used by the frontend.
NEXTAUTH_URL=https://example.com                            # NextAuth callback URL (must match deployed URL).
APP_BASE_URL=https://example.com                            # App base URL used in server-side links.

# ===== Default Owner Account =====
DEFAULT_OWNER_EMAIL=admin@example.com       # Seeded admin account email (created on first run).
DEFAULT_OWNER_PASSWORD=your-password        # Seeded admin account password (created on first run).

# ===== NextAuth =====
NEXTAUTH_SECRET=your-secret-key-32-chars-min # Secret for NextAuth session/signing.

# ===== Database =====
POSTGRES_HOST=localhost            # Postgres host.
POSTGRES_PORT=5432                 # Postgres port.
POSTGRES_DB=contact_center         # Database name.
POSTGRES_USER=your_user            # Database user.
POSTGRES_PASSWORD=your_password    # Database password.

# ===== Email (Mailgun) =====
EMAIL_API_KEY=key-xxxxxxxxxxxxxxxxxxxxxxxxxxxx    # Mailgun API key.
EMAIL_DOMAIN=mg.your-domain.com                   # Mailgun domain.
EMAIL_FROM=Your App <no-reply@your-domain.com>    # Default "from" address.
THREAT_NOTIFICATION_ADDRESS=security@example.com  # Destination for security/threat alerts.

# ===== Telnyx Core =====
TELNYX_BASE_PATH=https://api.telnyx.com        # Telnyx API base URL.
TELNYX_API_KEY=KEY0xxxxxxxxxxxxxxxxxxxxxxxx     # Primary Telnyx API key.
TELNYX_DEMO_PORTAL_API_KEY=KEY0xxxxxxxxxxxxxxx  # Telnyx API key used by Demo Portal flows.
TELNYX_WEBHOOK_SECRET=base64-or-plain-secret    # Telnyx webhook signing secret.

# ===== Telnyx Voice / Messaging =====
TELNYX_CALL_CONTROL_ID=0000000000000000000      # Call Control Application ID.
TELNYX_OUTBOUND_VOICE_PROFILE=0000000000000000  # Outbound Voice Profile ID.
TELNYX_MESSAGING_PROFILE_ID=00000000-0000-0000-0000-000000000000 # Messaging Profile ID.
TELNYX_RECORDING_PATH=./recordings/             # Local path for call recordings.
TELNYX_RECORDING_FORMAT=mp3                     # Recording format (mp3|wav).
TELNYX_RECORDING_CHANNELS=single                # Recording channels (single|dual).
TELNYX_SIP_CONNECTION_ID=0000000000000000000    # SIP Connection ID for trunking.
NEXT_PUBLIC_TELNYX_WEBRTC_REGION=auto            # WebRTC region (auto or specific region).
TELNYX_SUPERVISOR_FROM_NUMBER=+1XXXXXXXXXX       # Default caller ID for supervisor actions.
TELNYX_MAIN_FROM_NUMBER=+1XXXXXXXXXX             # Primary caller ID for outbound calls.

# ===== Telnyx AI / Insights =====
TELNYX_AI_API_KEY=your-webhook-api-key           # API key for AI webhook auth.
TELNYX_AI_API_KEY_REF=x-api-key                  # Header name for AI webhook auth.

# ===== Google OAuth =====
GOOGLE_ID=your-google-client-id                  # Google OAuth Client ID.
GOOGLE_SECRET=your-google-client-secret          # Google OAuth Client Secret.

# ===== ElevenLabs =====
ELEVENLABS_API_KEY_REF=elevenlabs-api-key        # Secret reference name for ElevenLabs API key.

# ===== Secrets Encryption =====
SECRETS_ENCRYPTION_KEY=your-64-hex-key           # 32-byte (64 hex chars) encryption key.

# ===== Optional: Allowed Email Domains =====
# ALLOWED_EMAIL_DOMAINS=example.com,company.com  # Comma-separated list of allowed signup domains.
