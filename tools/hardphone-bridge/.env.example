# Required. Same value must be configured on CC as HARDPHONE_BRIDGE_TOKEN.
# Generate with: openssl rand -hex 32
BRIDGE_TOKEN=change-me

# Outbound connection from the LAN bridge to Contact Center.
# For local Docker Desktop against the CC streaming sidecar running on the Mac:
CC_WS_URL=ws://host.docker.internal:3001/hardphone-bridge
BRIDGE_ID=local-lab
BRIDGE_SITE=local-lan
RECONNECT_MS=5000
HEARTBEAT_MS=25000

# Optional defaults. Prefer per-request credentials from Contact Center once integrated.
DEFAULT_POLY_ADMIN_PASSWORD=
DEFAULT_YEALINK_ADMIN_USER=admin
DEFAULT_YEALINK_ADMIN_PASSWORD=

# Optional MAC-to-IP hints for phones that cannot report their LAN IP to the cloud.
# Format: 00908f5610a5=10.10.10.138,0004f2cbf6d5=10.10.10.121
# The deploy script can auto-fill this from the local ARP cache when phones are online.
PHONE_MAC_IP_MAP=

PORT=8787
