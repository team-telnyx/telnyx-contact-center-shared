# Dockerfile-specific ignore file for docker/ghcr-production/Dockerfile.
# Keeps secrets and local build artifacts out of the GHCR image build context
# without changing the legacy docker/production build path.

.git
.github
.next
node_modules
coverage
.DS_Store
*.log

.env
.env.*
**/.env
**/.env.*

plan
plans
docs

# Runtime/uploaded media should be mounted at runtime, not baked into images.
public/media

# Legacy local deployment secrets/config are copied onto EC2 separately.
docker/production/.env
docker/ghcr-production/.env
