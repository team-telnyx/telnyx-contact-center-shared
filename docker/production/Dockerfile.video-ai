# Standalone media worker; it does not serve the Contact Center application.
FROM node:22-slim
ENV PUPPETEER_SKIP_DOWNLOAD=true VIDEO_AI_CHROMIUM_PATH=/usr/bin/chromium
RUN apt-get update && apt-get install -y --no-install-recommends chromium ffmpeg ca-certificates python3 make g++ libcairo2-dev libpango1.0-dev libjpeg-dev libgif-dev librsvg2-dev \
    && rm -rf /var/lib/apt/lists/*
RUN corepack enable
WORKDIR /app
COPY . .
# esbuild is required to bundle the browser bridge at worker startup.
RUN yarn install --immutable
RUN mkdir -p /app/.data/video-recordings && chown -R node:node /app/.data
USER node
ENV VIDEO_AI_BIND=0.0.0.0 VIDEO_AI_CONTROL_PORT=3092 VIDEO_AI_WORKER_CAPACITY=2
CMD ["node", "scripts/video-ai-worker.mjs"]
