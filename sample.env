# Debug mode - set to "mcp" to enable MCP debugging, or leave empty to disable
DEBUG=mcp

# Application environment - "development", "staging", or "production"
APP_ENV=development

# Node.js environment - "development" or "production" (affects Next.js optimizations)
NODE_ENV=development

# Comma-separated list of allowed CORS origins (e.g., "https://cc.domain.com,https://app.domain.com")
ALLOWED_ORIGINS=https://cc.domain.com

# Comma-separated list of allowed dev origins for Next.js (e.g., "dev.domain.com,api.domain.com")
# Used by Next.js for development server origin validation
ALLOWED_DEV_ORIGINS=dev.domain.com,api.domain.com

# Public base URL for the application (used in client-side code) - full URL including protocol
NEXT_PUBLIC_BASE_URL=https://cc.domain.com

# NextAuth.js base URL - must match your application's public URL
NEXTAUTH_URL=https://cc.domain.com

# Application base URL for server-side operations - full URL including protocol
APP_BASE_URL=https://cc.domain.com

# Authentication
# NextAuth.js secret key - generate with: openssl rand -base64 32
# Used to encrypt JWT tokens and session data
NEXTAUTH_SECRET=

# Allowed email domains for user registration (comma-separated)
# Domains will be automatically seeded to the database on startup
# Example: "company.com,subsidiary.com,partner.com"
ALLOWED_EMAIL_DOMAINS=domain.com

# Default owner user account (created automatically on first deployment)
# Email address for the default owner account (must match an allowed domain)
DEFAULT_OWNER_EMAIL=owner@domain.com

# Password for the default owner account (minimum 8 characters)
# IMPORTANT: Change this password after first login!
DEFAULT_OWNER_PASSWORD=

# Postgresql
# PostgreSQL server hostname or IP address
POSTGRES_HOST=localhost

# PostgreSQL server port (default: 5432)
POSTGRES_PORT=5432

# PostgreSQL database name
POSTGRES_DB=contact_center

# PostgreSQL database username
POSTGRES_USER=contact_center

# PostgreSQL database password
POSTGRES_PASSWORD=

# Email User
# Mailgun API key - get from https://app.mailgun.com/app/account/security/api_keys
EMAIL_API_KEY=

# Mailgun domain (e.g., "mg.yourdomain.com" or "sandbox-xxx.mailgun.org" for testing)
# Get from https://app.mailgun.com/app/sending/domains
EMAIL_DOMAIN=

# "From" email address for all outgoing emails - must be verified in Mailgun
EMAIL_FROM=

# Email address to receive threat/security notifications (optional)
THREAT_NOTIFICATION_ADDRESS=

# Endpoints
# Telnyx API base URL (usually https://api.telnyx.com)
TELNYX_BASE_PATH=https://api.telnyx.com

# Telnyx Config
# Telnyx API key - get from https://portal.telnyx.com/#/app/api-keys
TELNYX_API_KEY=

# Telnyx webhook signature verification key - Ed25519 public key (PEM format or hex/base64)
# Used to verify webhook requests are from Telnyx
# Get from Telnyx portal webhook configuration
TELNYX_WEBHOOK_SECRET=

# Telnyx Call Control Application ID (connection ID) - required for call routing
# Get from https://portal.telnyx.com/#/app/call-control/applications
TELNYX_CALL_CONTROL_ID=

# Telnyx outbound voice profile ID (optional - for outbound calls)
TELNYX_OUTBOUND_VOICE_PROFILE=

# Telnyx messaging profile ID (optional - for SMS/MMS)
TELNYX_MESSAGING_PROFILE_ID=

# Recording storage path/URL prefix (optional - for call recordings)
TELNYX_RECORDING_PATH=

# Recording format - "mp3", "wav", etc. (optional)
TELNYX_RECORDING_FORMAT=

# Recording channels - "single" or "dual" (optional)
TELNYX_RECORDING_CHANNELS=

# Telnyx SIP connection ID (optional - for SIP trunking)
TELNYX_SIP_CONNECTION_ID=

# WebRTC region - "auto", "us-east", "us-west", "eu-west", etc. (optional, defaults to "auto")
NEXT_PUBLIC_TELNYX_WEBRTC_REGION=

# Telnyx AI API key (optional - for AI features)
TELNYX_AI_API_KEY=

# Reference to Telnyx AI API key stored in secrets system (optional)
# Defaults to "telnyx-ai-api-key" if not set
TELNYX_AI_API_KEY_REF=

# Phone number to use for supervisor/barge-in calls (E.164 format, e.g., "+15551234567")
TELNYX_SUPERVISOR_FROM_NUMBER=

# Main phone number to use as fallback for outbound calls from softphones when user has no voice number assigned (E.164 format, e.g., "+15551234567")
TELNYX_MAIN_FROM_NUMBER=

# Google
# Google OAuth client ID - get from https://console.cloud.google.com/apis/credentials
GOOGLE_ID=

# Google OAuth client secret - get from https://console.cloud.google.com/apis/credentials
GOOGLE_SECRET=

# Encryption key for secrets management system - hex-encoded 64-character string (32 bytes)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required if using the secrets management features
SECRETS_ENCRYPTION_KEY=

# ── Streaming WebSocket Server ─────────────────────────────────────────────────
# Port for the streaming WebSocket server — server-side (default: main port + 1 = 3001)
# This server handles AI streaming for Google Gemini, OpenAI Realtime, and Azure Transcription
STREAMING_WS_PORT=3001

# Port exposed to the browser for building WebSocket URLs in the flow editor UI — client-side
# Must match STREAMING_WS_PORT (or your reverse proxy config if port is remapped externally)
NEXT_PUBLIC_STREAMING_PORT=3001

# Full WebSocket base URL for the streaming server (optional — auto-derived from APP_BASE_URL if not set)
# Used by voice-flow-engine to build stream_url for streaming_start node
# Example: ws://localhost:3001 (dev) or wss://cc.domain.com:3001 (prod)
STREAMING_WS_URL=

# Secret token for securing WebSocket streaming connections (optional but recommended)
# Telnyx will include this as ?secret= query param when connecting
STREAMING_SECRET=

# AI Provider API Keys (for Google Gemini Live and OpenAI Realtime in streaming_start node)
GEMINI_API_KEY=
OPENAI_API_KEY=

# ── Azure Cognitive Services Speech ───────────────────────────────────────────
# Azure region for Speech services (e.g. eastus, westeurope)
AZURE_SERVICE_REGION=eastus

# Azure Cognitive Services subscription key
AZURE_SUBSCRIPTION_KEY=

# Google Translate API key (for existing Agent Assist translation feature)
GOOGLE_TRANSLATE_API_KEY=