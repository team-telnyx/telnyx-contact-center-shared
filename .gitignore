# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
.claude/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
docker/production/.env

# macOS
.DS_Store

# Logs
logs/
Dockerfile.local

# Contact Center deployment wizard
/deploy/cli/node_modules/
/deploy/.cc-state.json
/deploy/.cc-telnyx-secrets.json
/deploy/cc.answers.json
/deploy/keys/
/deploy/.cc-credentials.txt
/deploy/.cc-tunnel.log

# Terraform (AWS cloud path, Phase 4) — local state/cache/vars are
# environment-specific and can contain secrets (tfvars carries the
# deployment name/region/instance sizing, never API keys, but state files
# can reflect resource attributes); never commit any of this.
**/.terraform/
**/.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfvars.json
!deploy/terraform/aws-required-policy.json
cc.tfplan

