#!/usr/bin/env bash
# Thin POSIX shim for the Contact Center deployment wizard CLI.
# Real logic lives in deploy/cli/cc.mjs (Node.js, @inquirer/prompts + chalk —
# same UX conventions as infra-cli).
#
# On first use, installs the CLI's isolated dependency tree (deploy/cli/node_modules)
# so this never touches the main app's package.json/yarn.lock.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CLI_DIR="$SCRIPT_DIR/cli"

NODE_RANGE="^22.13.0 || >=23.5.0"

if ! command -v node >/dev/null 2>&1; then
  echo "❌ Node.js is required to run the deployment wizard ($NODE_RANGE). Install it and try again." >&2
  exit 1
fi

# npm does not enforce the "engines" field in deploy/cli/package.json unless
# engine-strict is on, and it is off by default: an incompatible install only
# warns with EBADENGINE and then succeeds, leaving the wizard to fail later
# inside @inquirer. Check it here instead, before installing or launching.
# Keep this range in step with deploy/cli/package.json's "engines" — the test
# in deploy/cli/test/cc-shim.test.mjs fails if the two drift apart.
if ! node -e 'const [major, minor] = process.versions.node.split(".").map(Number); process.exit(((major === 22 && minor >= 13) || (major === 23 && minor >= 5) || major >= 24) ? 0 : 1)'; then
  echo "❌ Node.js $(node -p 'process.versions.node') is too old for the deployment wizard, which needs $NODE_RANGE." >&2
  echo "   @inquirer/prompts declares >=23.5.0 || ^22.13.0 || ^20.17.0, so 22.0-22.12 and 23.0-23.4 are not supported." >&2
  exit 1
fi

if [ ! -d "$CLI_DIR/node_modules" ]; then
  echo "📦 First run: installing deploy CLI dependencies (isolated from the app's own package.json)..." >&2
  ( cd "$CLI_DIR" && npm install --no-audit --no-fund --silent )
fi

exec node "$CLI_DIR/cc.mjs" "$@"
